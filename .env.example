# X.com authentication cookies (from browser dev tools or cookie exporter)
# Open Chrome DevTools → Application → Cookies → x.com
X_AUTH_TOKEN=your_auth_token_value_here
X_CT0=your_ct0_value_here
X_USER_ID=your_numeric_user_id_here  # from twid cookie

# Optional: your X username to fetch following list
X_USERNAME=your_x_username

# Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Autopilot config (optional; defaults shown)
GROQ_MODEL=llama-3.3-70b-versatile
REPLY_INTERVAL=7200        # seconds between reply cycles
QUOTE_INTERVAL=21600       # seconds between quote cycles
MAX_REPLIES_PER_RUN=5
MAX_QUOTES_PER_RUN=3
DAILY_REPLY_CAP=20
DAILY_QUOTE_CAP=6
